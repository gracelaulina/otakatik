{
  "expo": {
    "name": "OtakAtik",
    "slug": "otakatik",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#DCEEFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.otakatik.app"
    },
    "android": {
      "package": "com.otakatik.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "@react-native-google-signin/google-signin",
      "expo-audio"
    ]
  }
}
